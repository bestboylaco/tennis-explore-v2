node_modules/
.env
logs/
temp/
uploads/
coverage/
.DS_Store
Thumbs.db
npm-debug.log*
.claudeignore
.vs/
*.user
*.suo
# the built search index is COMMITTED on purpose.
#
# it is the whole point of this story: a teammate clones the repo, runs one
# command, and queries the same corpus that was evaluated -- rather than
# rebuilding their own index from their own machine and comparing two different
# things. ~30 mb at bge-m3 dimensions is well within what git handles.
#
# if it ever passes ~200 mb, move vectors.bin to a github release asset and put
# the download url in data/index/manifest.json instead. do not switch to
# "everyone builds their own".
!data/index/
!data/index/*

# scratch output for `npm run build:index:test` -- never the real index.
data/index-test/

# scratch index built from a subset of videos before merging into the real,
# committed data/index/ -- kept tracked on Tenk_corpus_duplication on purpose,
# ignored again once it's merged into data/index/ on the branch that does that.

# raw source documents are NOT committed. they are partner data, some of it
# classified internal or above, and the repo is not the right place for it.
data/raw/
data/video/

# the scanned pdfs fed to Textract. same rule as data/raw/ and the same reason:
# they are partner scans, not ours to publish.
#
# note what is NOT ignored: data/textract-cache/, which holds what Textract read
# out of them. that is committed on purpose -- see the note there and in
# docs/TEXTRACT.md. Textract output costs money against a hard 100-page monthly
# cap, so a teammate who clones this repo must inherit the pages we already paid
# for rather than spending their own allowance re-extracting the same files.
# data/ocr-cache/ is ignored instead because re-running local OCR is free.
data/scanned/

# locally seeded cache entries from bin/textract-seed.js. the exact opposite of
# data/textract-cache/: nothing here was paid for and nothing here came from
# Textract, so committing it would put invented cells beside real ones in the
# one directory whose whole value is that everything in it is real.
data/textract-cache-dev/

# python bytecode from the ingestion tools
__pycache__/
*.pyc

# prepared media and OCR output. large, machine-generated, and rebuilt by
# tools/prepare_corpus.py -- the INDEX is what gets committed, not its inputs.
# (data/media/ is tracked on Tenk_corpus_duplication on purpose: it's the g-l
# whisper transcripts data/index-video-gl/ was built from, kept so continuing
# this work doesn't mean re-running a 17-minute GPU transcribe for nothing.)
data/ocr-cache/

.venv/
mnt/
.profile


# Local vision models
models/vision/*.onnx