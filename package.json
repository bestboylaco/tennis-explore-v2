{
  "name": "tennis-explore-v2",
  "version": "1.0.0",
  "description": "Clean rebuild of the TennisExplore backend platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-force-exit --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "build:index": "node bin/build-index.js",
    "build:index:test": "node bin/build-index-test.js",
    "search": "node bin/search.js",
    "ask": "node bin/ask.js",
    "eval": "node bin/eval.js",
    "check:models": "node bin/check-models.js",
    "eval:answers": "node bin/eval-answers.js",
    "eval:refusal": "node bin/e5-18-refusal-test.mjs",
    "seed:users": "node bin/seed-users.js",
    "backfill:s3": "node bin/backfill-s3.js"
  },
  "keywords": [
    "tennis",
    "ai",
    "rag",
    "player-intelligence"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.0.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "nodemon": "^3.0.0"
  }
}
