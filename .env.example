# copy this file to .env and edit. every value below already has a sensible
# default in code, so a missing line is fine -- .env only exists to override.

# ---------------------------------------------------------------------------
# the web server (only needed for `npm start`, not for the retrieval scripts)
# ---------------------------------------------------------------------------
PORT=3000
MONGODB_URI=mongodb://localhost:27017/tennisexplore

# skip logging in locally by auto-granting an admin session on every request.
# leave unset/false everywhere else -- CI relies on real login being required.
ENABLE_DEV_AUTO_LOGIN=false

# ---------------------------------------------------------------------------
# ollama -- runs the models locally. nothing leaves your machine.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# embedding model
#
# bge-m3 is the default: 1024 dimensions, ~2.3 gb of vram, strong on both
# paraphrase and exact terms. if you change this you MUST change the dimension
# to match and rebuild the index from scratch -- an index is only readable by
# the model that built it.
#
#   model                    dims   vram    notes
#   bge-m3                   1024   2.3 gb  the default. good all-rounder.
#   qwen3-embedding:0.6b     1024   1.5 gb  smaller and faster, very close quality.
#   mxbai-embed-large        1024   0.7 gb  fast, but only a 512-token context.
#   nomic-embed-text          768   0.3 gb  smallest. use if vram is tight.
#
# set EMBEDDING_PROVIDER=hash to run the whole pipeline with no model at all.
# that is for testing the plumbing only -- the similarity it produces is
# meaningless and every tool will warn you about it.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# generation and reranking
# ---------------------------------------------------------------------------
# The model that writes answers. Changing this needs NO re-embedding -- the
# index is untouched by generation.
#
# What fits an 8 GB card, given bge-m3 (2.3 GB) is also resident and Ollama
# swaps models in and out:
#
#   llama3.1:8b                  4.7 GB   the default, solid at following
#                                         instructions and refusing
#   llama3.1:8b-instruct-q6_K    6.6 GB   SAME model, less quantisation loss.
#                                         usually a better bet than a bigger
#                                         model at heavier quantisation
#   gemma2:9b                    5.4 GB   comfortable, good at summarising
#   mistral-nemo:12b             7.1 GB   the largest that fits. tight -- expect
#                                         slower first responses as Ollama swaps
#
# Anything 14B and above wants ~9 GB at Q4 and will spill to system RAM, which
# is dramatically slower than a smaller model that fits.
#
# Do not guess which is better. Measure:
#   npm run eval:answers          (baseline)
#   ...change this line, then...
#   npm run eval:answers          (compare)
#
# Raising TOP_N and MAX_CONTEXT_CHARS is often a bigger win than a bigger model:
# for grounded answering, how much relevant evidence the model sees matters more
# than its parameter count.
OLLAMA_GENERATION_MODEL=llama3.1:8b

RERANK_ENABLED=true

# IMPORTANT: ollama has NO /api/rerank, and `ollama pull bge-reranker-v2-m3`
# fails because that model is not in ollama's library. it serves a reranker's
# embedding layer but not its classification head, so there is nothing to call.
#
# two working options:
#
#   llm      (default) score passages in batches with the chat model you already
#            have. needs nothing extra. decent, not as good as a cross-encoder.
#
#   service  a real cross-encoder over http. better. run:
#              pip install fastapi uvicorn sentence-transformers
#              python tools/rerank/rerank_server.py
#            then uncomment the two lines below.
RERANK_STRATEGY=llm
RERANK_LLM_MODEL=llama3.1:8b
# how many passages per scoring call. one per call meant 50 sequential round
# trips and ~90 seconds; ten per call is five concurrent calls.
RERANK_BATCH_SIZE=10

# RERANK_STRATEGY=service
# RERANK_API_URL=http://localhost:8787/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------------------
# retrieval behaviour -- see src/config/retrieval.config.js for what each means
# ---------------------------------------------------------------------------
BM25_K=50
DENSE_K=50
RRF_K=60
RERANK_INPUT=50
# How many chunks reach the model, and how much text they may total.
#
# NEITHER of these requires re-embedding. They are read at query time and are
# not part of the index build fingerprint -- change them, restart, done.
#
# The research is consistent that ~20 passages beats 5 or 10 for answer quality.
# The ceiling is the model's context window: llama3.1:8b has 8k tokens, roughly
# 32,000 characters, and you want headroom for the few-shot examples and the
# answer itself. If answers get vaguer rather than richer, you have found the
# point where the model is skimming.
TOP_N=16

CHUNK_TARGET_CHARS=1600
CHUNK_OVERLAP_CHARS=200

CONTEXTUAL_ENABLED=true
CONTEXTUAL_MODE=template

ROUTING_ENABLED=true
DECOMPOSITION_ENABLED=true

# the intent planner: fills in a schema-constrained form saying what the question
# is asking for. see docs/QUERY-HANDLING.md for why this is a form and not tool
# calling. set PLANNER_ENABLED=false to run on rules alone -- faster, less
# accurate on table questions.
# Ask the question several different ways when the first retrieval comes back
# thin, then fuse the results. Only fires when grading says the evidence is weak,
# so it costs nothing on questions that already worked.
EXPANSION_ENABLED=true

PLANNER_ENABLED=true
PLANNER_MODEL=llama3.1:8b
# rule confidence above this skips the planner call entirely
PLANNER_CONFIDENCE_FLOOR=0.8

# off on purpose. see docs/RETRIEVAL-DESIGN.md -- the current benchmarks put
# hyde below plain dense retrieval, and our own eval agrees.
HYDE_ENABLED=false

INDEX_DIR=data/index

# ---------------------------------------------------------------------------
# media ingestion (tools/media/ingest_media.py) -- optional, Python side only
# ---------------------------------------------------------------------------
VISION_MODEL=llava:7b
WHISPER_SIZE=small
# Whisper emits one segment per utterance -- measured at a median of 41
# characters, far too small to embed usefully. Consecutive utterances are merged
# into windows of about this size, keeping the first start and last end time so
# citations still deep-link correctly.
TRANSCRIPT_WINDOW_CHARS=1400
